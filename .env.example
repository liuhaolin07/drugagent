# Copy to .env or inject these names through environment settings.
# Configure at least one provider for full analysis; local BM25 needs no key.
GLM_API_KEY=
DEEPSEEK_API_KEY=
DRUGAGENT_MODEL=glm-4-flash
DRUGAGENT_HOST=127.0.0.1
DRUGAGENT_PORT=8077
# Relative paths resolve from the project directory.
DRUGAGENT_REPORTS_DIR=reports
# Optional cache directory; built-in corpus and candidate files stay in data/.
DRUGAGENT_CACHE_DIR=data
# Docker host binding; use 0.0.0.0 only when intentionally sharing on a network.
DRUGAGENT_BIND_ADDRESS=127.0.0.1
